{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build UncleRenderer Debug",
      "type": "shell",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Professional\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "${workspaceFolder}\\UncleRenderer.sln",
        "/p:Configuration=Debug",
        "/p:Platform=x64",
        "/m",
        "/nologo",
        "/v:minimal"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build UncleRenderer Release",
      "type": "shell",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Professional\\MSBuild\\Current\\Bin\\MSBuild.exe",
      "args": [
        "${workspaceFolder}\\UncleRenderer.sln",
        "/p:Configuration=Release",
        "/p:Platform=x64",
        "/m",
        "/nologo",
        "/v:minimal"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}